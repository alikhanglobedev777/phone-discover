# Native Windows Django environment. Generated by scripts/init-dev-env.ps1.
# Keep this template public and the real backend/.env.local private.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
POSTGRES_DB=mobile_discovery
POSTGRES_USER=mobile_discovery
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
REDIS_URL=redis://127.0.0.1:6379/0
AI_PROVIDER=deterministic
# Optional single-key mode; overrides the provider-specific key fields.
API_KEY=
API_PROVIDER=auto
AI_MODEL=
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Browser-search-capable model; used only for source-backed discovery.
GROQ_WEB_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_WEB_RESEARCH_ENABLED=0
GEMINI_AUTO_RESEARCH_ENABLED=0
GEMINI_RESEARCH_SOURCE_DOMAINS=whatmobile.com.pk,priceoye.pk
GEMINI_RESEARCH_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
