# Local Docker Compose only. Generate .env with scripts/init-dev-env.ps1.
# Never commit real passwords, AI keys or Django secrets.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
POSTGRES_DB=mobile_discovery
POSTGRES_USER=mobile_discovery
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mobile-media
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# The agentic research pipeline is added in later patches.
